{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ Project (Clang)",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "*.cpp",
        "-o",
        "${workspaceFolder}/juego"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "detail": "Compile all .cpp files with clang++ using C++17"
    }
  ]
}